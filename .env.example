# Copy to .env for local runs. Never commit real values.
# Every variable the code reads is listed here (constitution Principle VII).

# Agent
# simplified = rule based mode only, no AWS needed. full = Bedrock agent with simplified fallback.
AGENT_MODE=simplified
# Bedrock inference profile id (research R4). Only read when AGENT_MODE=full.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1

# Storage: leave TABLE_NAME empty to use the in memory store.
TABLE_NAME=

# Email: leave SES_FROM empty to use the outbox (printed and shown on the demo phone).
SES_FROM=

# Secrets: long random strings, at least 32 characters each. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
HOUSEHOLD_TOKEN_SECRET=
SESSION_SECRET=

# URLs
WEB_URL=http://localhost:8787
MCP_URL=http://localhost:8788/mcp

# Text to speech (Amazon Polly). Empty POLLY_VOICE falls back to browser speech.
POLLY_VOICE=
