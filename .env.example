# Copy to .env for local runs. Never commit real values.
# Every variable the code reads is listed here (constitution Principle VII).

# Agent
# simplified = rule based mode only, no AWS needed. full = Bedrock agent with simplified fallback.
AGENT_MODE=simplified
# Bedrock inference profile id (research R4). Only read when AGENT_MODE=full.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1

# Storage. Local runs always use the in memory store; the cloud functions get TABLE_NAME
# from the CDK stack (DynamoDB).
TABLE_NAME=

# Email. Local runs never send real email: messages go to the on screen demo phone, and while
# SES_FROM is empty the family sign in link is shown on screen. In the cloud it is the verified
# SES sender, passed to the stack with: pnpm deploy -- -c "sesFrom=Name <address>"
SES_FROM=

# Secrets: long random strings, at least 32 characters each. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
HOUSEHOLD_TOKEN_SECRET=
SESSION_SECRET=

# URLs and ports. Local runs mount the MCP server on the web app at /mcp.
WEB_PORT=8787
WEB_URL=http://localhost:8787
MCP_URL=http://localhost:8787/mcp
# Standalone MCP server for MCP Inspector (pnpm --filter @asg/mcp-server dev)
MCP_PORT=8788

# How often the simulated Echo checks for family replies, in milliseconds.
DEMO_POLL_MS=3000

# Text to speech (Amazon Polly). Empty POLLY_VOICE falls back to browser speech.
POLLY_VOICE=

# Cloud functions only, set by the CDK stack (infra/src/stack.ts), never by hand:
#   APP_SECRET_ARN  Secrets Manager master secret; token and cookie secrets are derived from it
#   WEB_URL_PARAM   SSM parameter holding the public web URL
#   PORT            AgentCore container port (default 8000)
# Scripts:
#   APP_SECRET      pnpm token:demo against a deployed stack (or use pnpm token:cloud)
#   CDK_DEFAULT_ACCOUNT  read by the CDK app; set by the CDK CLI from your credentials
# Tests and tools (set on the command line, not in .env):
#   E2E_BASE_URL    run the Playwright suite against a deployed or rehearsed site
#   TEST_STORE      dynamo: run the contract tests on the DynamoDB store (CI does both)
#   DEMO_PLAY, VIDEO_CARDS, SHOTS_DIR  set by pnpm demo:play, pnpm video:cards and captures
