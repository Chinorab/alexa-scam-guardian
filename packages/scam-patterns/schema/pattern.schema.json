{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chinorab/alexa-scam-guardian/packages/scam-patterns/schema/pattern.schema.json",
  "title": "Scam patterns from official US sources",
  "description": "Warning signs, scam patterns, steps after paying, and help resources. Every entry points to an FTC, FBI or IC3 source; DOJ sources are allowed for help resources only.",
  "type": "object",
  "required": ["version", "sources", "warningSigns", "patterns", "ifPaid", "resources"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "warningSigns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/warningSign" }
    },
    "patterns": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/pattern" }
    },
    "ifPaid": {
      "type": "object",
      "required": [
        "gift_card",
        "wire",
        "money_transfer_app",
        "crypto",
        "cash_mail",
        "cash_courier",
        "bank_transfer",
        "other"
      ],
      "additionalProperties": false,
      "patternProperties": {
        ".*": { "$ref": "#/$defs/paidSteps" }
      }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "source": {
      "type": "object",
      "required": ["publisher", "title", "label", "url", "retrievedOn"],
      "additionalProperties": false,
      "properties": {
        "publisher": { "enum": ["FTC", "FBI", "IC3", "DOJ"] },
        "title": { "type": "string", "description": "Official title, verbatim." },
        "label": {
          "type": "string",
          "description": "Short label shown on screen, for example \"FTC consumer alert, March 2023\"."
        },
        "url": {
          "type": "string",
          "pattern": "^https://([a-z0-9-]+\\.)*(ftc\\.gov|fbi\\.gov|ic3\\.gov|justice\\.gov|ojp\\.gov)(/.*)?$"
        },
        "retrievedOn": { "type": "string", "format": "date" }
      }
    },
    "warningSign": {
      "type": "object",
      "required": ["id", "label", "explanation", "cues", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "description": "Speakable, fits after \"the\"." },
        "explanation": { "type": "string", "description": "One spoken sentence." },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "description": "Case insensitive regular expression." }
        },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "pattern": {
      "type": "object",
      "required": ["id", "name", "description", "signIds", "advice", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "signIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "advice": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "paidSteps": {
      "type": "object",
      "required": ["steps", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "resource": {
      "type": "object",
      "required": ["id", "name", "whenToUse", "url", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "whenToUse": { "type": "string" },
        "url": { "type": "string" },
        "phone": { "type": "string", "description": "Digits separated by spaces, no dashes." },
        "hours": { "type": "string" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
