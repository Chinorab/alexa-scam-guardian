{
  "name": "@asg/scam-patterns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scam patterns from official FTC and FBI alerts, each with its source",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check-sources": "tsx scripts/check-sources.ts",
    "check-sources:online": "tsx scripts/check-sources.ts --online"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "main": "./src/index.ts"
}
